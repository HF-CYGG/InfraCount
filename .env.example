WEB_HOST=0.0.0.0
WEB_PORT=8000
TCP_HOST=0.0.0.0
TCP_PORT=8085
INFRACOUNT_IMAGE=infracount:local
INFRACOUNT_NO_BROWSER=1
INFRACOUNT_LOG_MODE=stdio

DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=infrared
DB_SQLITE_PATH=/app/data/infrared.db
INITIAL_ADMIN_PASSWORD=

CSRF_ENABLE=1
CSRF_TTL=600
ACTIVITY_CSV_MAX_BYTES=10485760
ACTIVITY_EXCEL_MAX_BYTES=26214400
DEVICE_LOG_MAX_BYTES=26214400
DB_MERGE_MAX_BYTES=536870912

TIME_SYNC_DIGITS=1
UPLOAD_INTERVAL=0005
DATA_START_TIME=0000
DATA_END_TIME=2359
BTX_LOW=30
BAT_LOW=20
SIGNAL_OFFLINE_VALUE=1
REC_TYPE_BACKLOG=1

SESSION_COOKIE_NAME=session_token
SESSION_MAX_AGE_SEC=604800
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=lax
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

AUTO_SYNC_WALKIN_ENABLE=1
AUTO_SYNC_WALKIN_INTERVAL_SEC=1800
AUTO_SYNC_WALKIN_BACKFILL_DAYS=1

ALERT_EMAIL_ENABLE=0
ALERT_EMAIL_SCAN_INTERVAL_SEC=60
ALERT_EMAIL_MAX_PER_SCAN=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_FROM=
SMTP_TO=
SMTP_SUBJECT_PREFIX=[InfraCount]
